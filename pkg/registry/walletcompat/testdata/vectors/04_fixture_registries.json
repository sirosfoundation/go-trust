[
  {
    "name": "lote_known_entity_resolution",
    "description": "Resolution-only lookup for entity present in the LoTE fixture (SIROS Identity Credential Issuer)",
    "flow": "issuance",
    "source": "authzenclient.Resolve() against LoTE with known entity",
    "request": {
      "subject": {"type": "key", "id": "https://issuer.siros.org"},
      "resource": {"id": "https://issuer.siros.org"}
    },
    "expectations": {
      "fixture/lote": {"decision": true},
      "fixture/etsi_lote_xml": {"decision": false},
      "static/always_trusted": {"decision": true},
      "static/never_trusted": {"decision": false}
    }
  },
  {
    "name": "lote_unknown_entity_resolution",
    "description": "Resolution-only lookup for entity NOT present in the LoTE fixture",
    "flow": "issuance",
    "source": "authzenclient.Resolve() against LoTE with unknown entity",
    "request": {
      "subject": {"type": "key", "id": "https://unknown-issuer.example.com"},
      "resource": {"id": "https://unknown-issuer.example.com"}
    },
    "expectations": {
      "fixture/lote": {"decision": false},
      "fixture/etsi_lote_xml": {"decision": false},
      "static/always_trusted": {"decision": true},
      "static/never_trusted": {"decision": false}
    }
  },
  {
    "name": "lote_known_entity_x5c_no_keys",
    "description": "x5c evaluation for entity in LoTE fixture — entity has no digital identity keys so key match fails",
    "flow": "issuance",
    "source": "authzenclient.EvaluateX5C() against LoTE with known entity but no cached keys",
    "request": {
      "subject": {"type": "key", "id": "https://issuer.siros.org"},
      "resource": {"type": "x5c", "id": "https://issuer.siros.org", "key": ["$TEST_CERT_B64"]},
      "action": {"name": "credential-issuer"}
    },
    "expectations": {
      "fixture/lote": {"decision": false, "reason_contains": "key does not match"},
      "fixture/etsi_lote_xml": {"decision": false, "reason_contains": "not found"},
      "static/always_trusted": {"decision": true},
      "static/never_trusted": {"decision": false}
    }
  },
  {
    "name": "ewc_entity_resolution",
    "description": "Resolution-only lookup for EWC entity present in the XML fixture",
    "flow": "issuance",
    "source": "authzenclient.Resolve() against LoTE XML with EWC entity",
    "request": {
      "subject": {"type": "key", "id": "http://uri.etsi.org/TrstSvc/Svctype/EAA#tsp0-svc0"},
      "resource": {"id": "http://uri.etsi.org/TrstSvc/Svctype/EAA#tsp0-svc0"}
    },
    "expectations": {
      "fixture/etsi_lote_xml": {"decision": true},
      "fixture/lote": {"decision": false},
      "static/always_trusted": {"decision": true},
      "static/never_trusted": {"decision": false}
    }
  },
  {
    "name": "ewc_entity_jwk_no_keys",
    "description": "JWK evaluation for EWC entity — entity may have no JWK keys in digital identity",
    "flow": "issuance",
    "source": "authzenclient.EvaluateJWK() against LoTE XML with EWC entity",
    "request": {
      "subject": {"type": "key", "id": "http://uri.etsi.org/TrstSvc/Svctype/EAA#tsp0-svc0"},
      "resource": {"type": "jwk", "id": "http://uri.etsi.org/TrstSvc/Svctype/EAA#tsp0-svc0", "key": ["$TEST_JWK"]},
      "action": {"name": "credential-issuer"}
    },
    "expectations": {
      "fixture/etsi_lote_xml": {"decision": false, "reason_contains": "key does not match"},
      "fixture/lote": {"decision": false, "reason_contains": "not found"},
      "static/always_trusted": {"decision": true},
      "static/never_trusted": {"decision": false}
    }
  }
