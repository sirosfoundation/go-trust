    "flow": "issuance",
    "source": "go-wallet-backend issuermetadata/resolver.go evaluateX5CTrust()",
    "request": {
      "subject": {"type": "key", "id": "https://issuer.example.com"},
      "resource": {"type": "x5c", "id": "https://issuer.example.com", "key": ["$TEST_CERT_B64"]},
      "action": {"name": "credential-issuer"}
    },
    "expectations": {
      "static/always_trusted": {"decision": true},
      "static/never_trusted": {"decision": false}
    }
  },
